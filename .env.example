# Every ITP_ setting (M-58 Settings). Copy to .env for local development.
# Placeholders only: never put real secrets, IBANs or tokens here (G-05).

# Required
ITP_DATABASE_URL=postgresql+asyncpg://itp:itp-local-only@localhost:5432/itp
ITP_REDIS_URL=redis://localhost:6379/0
ITP_OBJECT_BUCKET=itp-local
ITP_VAULT_URL=http://localhost:8200
ITP_ERP_MCP_URL=http://localhost:8100/mcp
ITP_MAIL_MCP_URL=http://localhost:8101/mcp
# Model roles as provider:model (anthropic, openai or deepseek); keys come from the provider SDK variables, never this file
ITP_LLM_EXTRACT_MODEL=anthropic:claude-sonnet-5-5
ITP_LLM_REASON_MODEL=anthropic:claude-opus-5-5
# Pinned Jev version, never jev-latest: decide in OD-04
ITP_JEV_MODEL=choose-in-OD-04
ITP_EMBEDDING_MODEL=openai:text-embedding-3-small
# Bearer-token verification (RS256). Paste the identity provider's PEM public key on one line,
# with each line break written as \n.
ITP_AUTH_ISSUER=https://idp.example
ITP_AUTH_AUDIENCE=invoice-to-pay
ITP_AUTH_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nreplace-with-idp-public-key\n-----END PUBLIC KEY-----

# Object storage (S3Storage). Standard AWS SDK variables, read by aioboto3 itself.
# Locally these point at the docker-compose MinIO; in production use the host's IAM role instead.
AWS_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=itp-local
AWS_SECRET_ACCESS_KEY=itp-local-only
AWS_REGION=us-east-1

# Optional (defaults shown)
# ITP_POST_ALONE_MAX_AED=25000
# ITP_TWO_APPROVER_MIN_AED=250000
# ITP_DAILY_AUTONOMOUS_CAP_AED=500000
# ITP_DOC_TYPE_THRESHOLD=0.9
# ITP_LINE_MAP_THRESHOLD=0.9
# ITP_NEAR_DUPLICATE_THRESHOLD=0.7
# ITP_APPROVAL_TTL_HOURS=24
# ITP_OTEL_ENDPOINT=http://localhost:4317
# ITP_AGENT_SUBJECT=agent:invoice-to-pay

# Provider keys for the model roles above (read by the provider SDKs, never by this app's code).
# Set only the ones your roles use. Real values go in your shell or a secret store, not here.
# ANTHROPIC_API_KEY=replace-me
# OPENAI_API_KEY=replace-me
# DEEPSEEK_API_KEY=replace-me
