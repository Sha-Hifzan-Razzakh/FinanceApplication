{
  "permissions": {
    "allow": [
      "Bash(uv run:*)",
      "Bash(uv sync:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run alembic:*)",
      "Bash(uv run lint-imports:*)",
      "Bash(make lint)",
      "Bash(make typecheck)",
      "Bash(make test-unit)",
      "Bash(make test-int)",
      "Bash(make test-scenarios)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(curl -X POST:*)",
      "Bash(curl -X PUT:*)",
      "Bash(curl -X PATCH:*)",
      "Bash(curl -X DELETE:*)",
      "Bash(curl --data:*)",
      "Bash(curl -d:*)",
      "Read(./.env)"
    ]
  }
}
